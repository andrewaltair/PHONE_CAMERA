# Writes ${OUT}: mycam::ResourceData(int) serving the files companion.rc embeds on Windows, by the same ids
# (the tray icons for mycam-tray, the rest for mycam-companion).
# Run at build time (pc/linux.cmake), so editing a page file rebuilds it.
set(assets
    301 companion/web/index.html
    302 companion/web/app.js
    303 companion/web/protocol.js
    304 companion/web/style.css
    305 ../design/assets/app-256.png
    201 companion/res/frame_paused.png
    202 companion/res/frame_waiting.png
    101 companion/res/tray_disconnected.ico
    102 companion/res/tray_ready.ico
    103 companion/res/tray_streaming.ico
    104 companion/res/tray_paused.ico
    105 companion/res/tray_error.ico)
set(code "// Generated by pc/cmake/embed_assets.cmake from the files companion.rc embeds. Do not edit.\n#include \"platform.h\"\n\nnamespace mycam {\n\nstd::string ResourceData(int id) {\n    switch (id) {\n")
list(LENGTH assets n)
math(EXPR last "${n} - 1")
foreach(i RANGE 0 ${last} 2)
    math(EXPR j "${i} + 1")
    list(GET assets ${i} id)
    list(GET assets ${j} file)
    file(READ "${SRC}/${file}" hex HEX)
    string(LENGTH "${hex}" hexlen)
    math(EXPR size "${hexlen} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "\\\\x\\1" escaped "${hex}")
    # Split the literal into 4 KB pieces: compilers limit a single string literal's length.
    string(REGEX REPLACE "((\\\\x[0-9a-f][0-9a-f]){1024})" "\\1\"\n            \"" escaped "${escaped}")
    string(APPEND code "    case ${id}: // ${file}\n        return std::string(\"${escaped}\", ${size});\n")
endforeach()
string(APPEND code "    }\n    return std::string();\n}\n\n} // namespace mycam\n")
file(WRITE "${OUT}.tmp" "${code}")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
