{
  "name": "phone-camera",
  "version": "1.0.0",
  "description": "Turn an Android phone or iPhone into a Windows webcam using PHONE_CAMERA's native virtual camera.",
  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "start": "node scripts/launch-native.cjs",
    "legacy": "node server.js",
    "test": "node --test tests/webrtc-behavior.test.js tests/native-launcher.test.js",
    "test:phone": "node native/phone-camera/pc/tools/webtest/identity_check.js && node native/phone-camera/pc/tools/webtest/golden_check.js native/phone-camera/protocol/golden.txt"
  },
  "keywords": [
    "webrtc",
    "iphone",
    "webcam",
    "virtual-camera",
    "obs",
    "ios",
    "camera",
    "streaming",
    "low-latency",
    "getusermedia",
    "wireless-webcam"
  ],
  "author": "Andrew Altair",
  "license": "MIT",
  "homepage": "https://github.com/andrewaltair/PHONE_CAMERA#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrewaltair/PHONE_CAMERA.git"
  },
  "bugs": {
    "url": "https://github.com/andrewaltair/PHONE_CAMERA/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.18.0"
  }
}
